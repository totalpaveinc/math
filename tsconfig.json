{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["es2017", "esnext.float16"],
        "module": "commonjs",
        "declaration": true,
        "sourceMap": true,
        "rootDir": "./src",
        "outDir": "./lib",
        "types": ["node"],
        "importHelpers": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "strictNullChecks": true,
        "plugins": [],
        "incremental": true
    },
    "exclude": [
        "**/*.spec.ts",
        "*/.spec.ts",
        "tests",
        "lib",
        "spec",
        "node_modules",
        "jest.config.ts"
    ]
}
